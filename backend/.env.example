# =============================================================
# Aman Agency — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Required variables (*) must be set; the app will panic on startup if missing.
# =============================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development           # production | development
APP_PORT=3000                 # HTTP listen port
APP_VERSION=dev               # Shown in /api/health response

# ── MongoDB ───────────────────────────────────────────────────────────────────
# * Required
MONGO_URI=mongodb://localhost:27017    # Full connection URI (supports SRV, replica sets, Atlas)
MONGO_DB=aman_agency                  # Database name

# ── JWT Authentication ────────────────────────────────────────────────────────
# * Required — use a long, random secret (e.g. openssl rand -hex 64)
JWT_SECRET=Zk9xT2pWc3FQeG5lR1RrU0p3bU5pQ1h6YlV5a0pTQnFhR3dNdmZQeExyU3p5VnV4R0F0cFhOa2pQdE1yV2pXbQ==

JWT_ACCESS_TTL=15m            # Access token lifetime  (Go duration: 15m, 1h, etc.)
JWT_REFRESH_TTL=168h          # Refresh token lifetime (default: 7 days)

# ── Encryption (AES-GCM) ──────────────────────────────────────────────────────
# * Required — exactly 32 bytes (64 hex chars), e.g. openssl rand -hex 32
ENCRYPTION_KEY=9f3c6b2e7a1d4c8f5b9a0e6d3c2f7a8b1e4d9c6a0f3b8e7d2c5a1f9b6e3d4c7a

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the browser PWA
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── WhatsApp (optional, for bill/receipt delivery) ────────────────────────────
WA_PROVIDER=twilio            # twilio | 360dialog | waba
WA_API_KEY=                   # Provider API key / token
WA_FROM_NUMBER=               # Sender number in E.164 format (+91XXXXXXXXXX)

# ── PDF / Invoice Storage ─────────────────────────────────────────────────────
PDF_STORAGE_PATH=/app/storage/invoices   # Absolute path inside container
STATIC_BASE_URL=http://localhost/static  # Public-facing base URL for stored files

# ── Log Level (optional, Zerolog) ─────────────────────────────────────────────
# LOG_LEVEL=info               # trace | debug | info | warn | error | fatal
