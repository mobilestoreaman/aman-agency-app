# =============================================================
# Aman Agency — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Required variables (*) must be set; the app will panic on startup if missing.
# =============================================================

# ── Application ───────────────────────────────────────────────

# Environment: production | development
APP_ENV=development

# HTTP listen port
APP_PORT=3000

# Shown in /api/health response
APP_VERSION=dev


# ── MongoDB ───────────────────────────────────────────────────

# * Required — Full connection URI.
# For local dev (no Docker): use localhost with your local MongoDB credentials.
# For Docker dev (make dev): this file is NOT used — infra/.env is loaded instead.
MONGO_URI=mongodb://localhost:27017/aman_agency

# Database name
MONGO_DB=aman_agency


# ── JWT Authentication ────────────────────────────────────────

# * Required — use a long, random secret (e.g. openssl rand -hex 64)
JWT_SECRET=e969b71161f1a38f1a2abc2f0e6fc69b51d2c3fb5b31c9372d1a23571f4941e6d8da744efa48839a9ab111cad886d0f3f77cc51db05ef9ccc535af912c58c21c

# Access token lifetime (Go duration: 15m, 1h, etc.)
JWT_ACCESS_TTL=15m

# Refresh token lifetime (default: 7 days)
JWT_REFRESH_TTL=168h


# ── Encryption (AES-GCM) ──────────────────────────────────────

# * Required — exactly 32 bytes (64 hex chars), e.g. openssl rand -hex 32
ENCRYPTION_KEY=d58fd0b0a54bb2bf72d32818991924ea290e0b0fb250582eaad15e1ba5d2b3c6


# ── CORS ──────────────────────────────────────────────────────

# Comma-separated list of allowed origins for the browser PWA
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ── WhatsApp (optional, for bill/receipt delivery) ────────────

# Provider: twilio | 360dialog | waba
# WA_PROVIDER=twilio
WA_PROVIDER=noop

# Provider API key / token
WA_API_KEY=

# Sender number in E.164 format (+91XXXXXXXXXX)
WA_FROM_NUMBER=


# ── PDF / Invoice Storage ─────────────────────────────────────

# Absolute path inside container
PDF_STORAGE_PATH=/app/storage/invoices

# Public-facing base URL for stored files
STATIC_BASE_URL=http://localhost/static


# ── Log Level (optional, Zerolog) ─────────────────────────────

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info