# ============================================================
# Aman Agency — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_ENV=production          # production | development
APP_PORT=3000

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h        # 7 days

# ── MongoDB ─────────────────────────────────────────────────
# App-level credentials (least privilege — readWrite only)
# Must match MONGO_APP_PASSWORD used in 01_init.js
MONGO_URI=mongodb://aman_app:replace_with_app_password@mongo:27017/aman_agency?authSource=aman_agency
MONGO_DB=aman_agency
MONGO_APP_PASSWORD=replace_with_app_password   # used by 01_init.js + MONGO_URI above

# Root credentials — used only by the mongo container on first-run init
# The app never connects with root; keep these separate and strong.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_root_password
MONGO_INITDB_DATABASE=aman_agency

# ── Encryption (AES-GCM for sensitive fields, e.g. WA key) ──
ENCRYPTION_KEY=replace_with_32_byte_hex_key   # 64 hex chars = 32 bytes

# ── WhatsApp Provider ────────────────────────────────────────
# Provider: twilio | 360dialog | waba
WA_PROVIDER=twilio
WA_API_KEY=replace_with_whatsapp_api_key
WA_FROM_NUMBER=+1234567890

# ── PDF / Storage ────────────────────────────────────────────
PDF_STORAGE_PATH=/app/storage/invoices
STATIC_BASE_URL=http://localhost/static

# ── TLS / Domain ─────────────────────────────────────────────
# Set DOMAIN to enable the ssl.conf server block.
# Certbot will provision certs to /etc/letsencrypt/live/$DOMAIN/
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,https://yourdomain.com

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100          # requests per window
RATE_LIMIT_WINDOW=1m

# ── Mongo Express (DEV ONLY — never expose in prod) ──────────
ME_CONFIG_MONGODB_ADMINUSERNAME=root
ME_CONFIG_MONGODB_ADMINPASSWORD=replace_with_strong_password
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=replace_with_me_password
